---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import { formatDate, SITE } from '../../lib/posts';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Tag-based recommendations: rank other posts by shared-tag count,
// recency as the tiebreak, then fill remaining slots with the most
// recent posts that share no tags (graceful fallback).
const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const scored = all
	.filter((p) => p.id !== post.id)
	.map((p) => ({
		post: p,
		score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
	}))
	.sort(
		(a, b) =>
			b.score - a.score ||
			b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
	);
const related = scored.slice(0, 4);
---
<!doctype html>
<html lang="en" id="top">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{post.data.title} — {SITE.name}</title>
		<meta name="description" content={post.data.description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-ground font-display text-ink">
		<Header />

		<main class="mx-auto max-w-[1200px] px-gutter pt-10 pb-16">
			<!-- The article shares the clicked card's transition name,
			     so the card morphs into this open content block -->
			<div class="grid max-w-full grid-cols-1 gap-10 md:grid-cols-3 md:gap-12">
				<article
					transition:name={`post-${post.id}`}
					style="view-transition-class: post-panel"
					class="min-w-0 md:col-span-2"
				>
					<a
						href="/"
						class="inline-flex items-center gap-2 border-4 border-ink bg-white px-4 py-2 text-[15px] leading-none font-semibold uppercase hover:translate-x-[2px] hover:translate-y-[2px]"
					>
						<Icon name="lucide:arrow-left" size={16} />
						All posts
					</a>

					{
						post.data.heroImage && (
							<img
								src={post.data.heroImage}
								alt={`Cover image for “${post.data.title}”`}
								class="mt-8 aspect-16/9 w-full border-4 border-ink object-cover shadow-[8px_8px_0_0_#000]"
							/>
						)
					}

					<h1
						class="mt-8 text-4xl leading-[1.05] font-extrabold tracking-tighter sm:text-5xl"
					>
						{post.data.title}
					</h1>

					<p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[14px] leading-none font-semibold uppercase">
						<span class="flex items-center gap-1.5">
							<Icon name="lucide:calendar" size={14} />
							<time datetime={post.data.pubDate.toISOString().slice(0, 10)}
								>{formatDate(post.data.pubDate)}</time
							>
						</span>
						<span aria-hidden="true">·</span>
						<span class="flex items-center gap-1.5">
							<Icon name="lucide:clock" size={14} />
							{post.data.readTime} min read
						</span>
					</p>

					{
						post.data.tags.length > 0 && (
							<ul class="mt-4 flex flex-wrap gap-2">
								{post.data.tags.map((tag) => (
									<li class="flex items-center gap-1.5 border-2 border-ink bg-white px-2 py-1 text-[14px] leading-none font-semibold uppercase">
										<Icon name="lucide:tag" size={13} />
										{tag}
									</li>
								))}
							</ul>
						)
					}

					<div class="prose-bauhaus mt-10 max-w-[68ch]">
						<Content />
					</div>
					<a
						href="/"
						class="mt-14 inline-flex items-center gap-2 border-4 border-ink bg-white px-4 py-2 text-[15px] leading-none font-semibold uppercase hover:translate-x-[2px] hover:translate-y-[2px]"
					>
						<Icon name="lucide:arrow-left" size={16} />
						All posts
					</a>
				</article>

				<!-- Column 3: tag-matched related posts -->
				<aside
					aria-label="Related posts"
					class="self-start md:mt-8 lg:sticky lg:top-8"
				>
					<h2
						class="flex items-center gap-2.5 border-4 border-ink bg-ink px-4 py-2.5 text-xl font-extrabold tracking-tighter text-white uppercase"
					>
						<Icon name="lucide:layers" size={18} />
						Related posts
					</h2>
					<ul class="mt-6 flex flex-col gap-6">
						{
							related.map(({ post: relatedPost, score }) => (
								<li>
									<a
										href={`/posts/${relatedPost.id}/`}
										transition:name={`post-${relatedPost.id}`}
										style="view-transition-class: post-panel"
										class="group flex flex-col gap-2 border-4 border-ink bg-white p-5 shadow-[6px_6px_0_0_#000] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[3px_3px_0_0_#000]"
									>
										<p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13px] leading-none font-semibold uppercase">
											<span class="flex items-center gap-1.5">
												<Icon name="lucide:calendar" size={13} />
												<time
													datetime={relatedPost.data.pubDate
														.toISOString()
														.slice(0, 10)}
												>
													{formatDate(relatedPost.data.pubDate)}
												</time>
											</span>
											<span aria-hidden="true">·</span>
											<span class="flex items-center gap-1.5">
												<Icon name="lucide:clock" size={13} />
												{relatedPost.data.readTime} min read
											</span>
										</p>
										<h3 class="flex items-start justify-between gap-3 text-lg leading-tight font-bold tracking-tight">
											{relatedPost.data.title}
											<Icon
												name="lucide:arrow-up-right"
												size={16}
												class="mt-0.5 shrink-0 opacity-40 transition-opacity group-hover:opacity-100"
											/>
										</h3>
										<p class="text-[15px] leading-snug font-normal line-clamp-2">
											{relatedPost.data.description}
										</p>
										<p class="mt-1 flex flex-wrap gap-2">
											{
												score > 0 && (
													<span class="flex items-center gap-1.5 border-2 border-ink bg-accent px-2 py-0.5 text-[13px] leading-none font-semibold text-white uppercase">
														<Icon name="lucide:tags" size={12} />
														{score} shared{' '}
														{score === 1 ? 'tag' : 'tags'}
													</span>
												)
											}
											{relatedPost.data.tags.map((tag) => (
												<span class="flex items-center gap-1 border-2 border-ink px-2 py-0.5 text-[13px] leading-none font-semibold uppercase">
													<Icon name="lucide:tag" size={12} />
													{tag}
												</span>
											))}
										</p>
									</a>
								</li>
							))
						}
					</ul>
				</aside>
			</div>
		</main>

		<Footer />
		<BackToTop />
	</body>
</html>
