---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import PostArticle from '../../components/PostArticle.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { SITE } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<!doctype html>
<html lang="en" id="top">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{post.data.title} — {SITE.name}</title>
		<meta name="description" content={post.data.description} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-ground font-display text-ink">
		<Header />

		<main class="mx-auto max-w-[1200px] px-gutter pt-10 pb-16">
			<!-- Reading columns: article spans 1–2, related sidebar 3.
			     PostArticle carries the card's transition name, so the
			     clicked card morphs into this open content block -->
			<div class="grid max-w-full grid-cols-1 gap-10 md:grid-cols-3 md:gap-12">
				<PostArticle post={post}>
					<Content />
				</PostArticle>

				<RelatedPosts post={post} />
			</div>
		</main>

		<Footer />
		<BackToTop />
	</body>
</html>
