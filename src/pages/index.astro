---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE, formatDate } from '../lib/posts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Exactly one post flagged featured; it renders first and oversized
const featuredPost = posts.find((p) => p.data.featured);
const otherPosts = posts.filter((p) => !p.data.featured);
const totalPosts = posts.length;
---

<!doctype html>
<html lang="en" id="top">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{SITE.name} — {SITE.tagline}</title>
		<meta name="description" content={SITE.description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-ground font-display text-ink">
		<Header />

		<main>
			<!-- Search-first band: the page opens straight into the posts -->
			<section id="posts" aria-label="Search blog posts" class="mx-auto max-w-[1200px] px-gutter pt-10">
				<form role="search" class="flex w-full flex-col gap-4 lg:flex-row lg:items-end">
					<div class="w-full lg:flex-1">
						<label
							for="blog-search"
							class="mb-2 block text-[15px] leading-none font-semibold uppercase"
						>
							Search posts
						</label>
						<div class="flex w-full border-4 border-ink bg-white shadow-[8px_8px_0_0_#000]">
							<span
								aria-hidden="true"
								class="grid w-14 shrink-0 place-items-center border-r-4 border-ink bg-accent text-white"
							>
								<Icon name="lucide:search" size={20} />
							</span>
							<input
								id="blog-search"
								type="search"
								placeholder="Title, description or tag…"
								autocomplete="off"
								class="w-full bg-transparent px-5 py-4 text-[19px] placeholder:text-ink/40 focus-visible:outline-none"
							/>
						</div>
					</div>
					<div class="w-full lg:w-auto">
						<label
							for="post-sort"
							class="mb-2 block text-[15px] leading-none font-semibold uppercase"
						>
							Sort
						</label>
						<div class="relative w-full lg:w-auto">
							<select
								id="post-sort"
								class="w-full cursor-pointer appearance-none border-4 border-ink bg-field py-4 pr-12 pl-6 text-[15px] font-bold text-on-field uppercase shadow-[8px_8px_0_0_#000]"
							>
								<option value="newest">Newest</option>
								<option value="oldest">Oldest</option>
								<option value="shortest">Shortest</option>
								<option value="longest">Longest</option>
							</select>
							<Icon
								name="lucide:chevrons-up-down"
								size={18}
								aria-hidden="true"
								class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-on-field"
							/>
						</div>
					</div>
				</form>
				<p
					id="search-count"
					aria-live="polite"
					class="mt-3 text-[14px] font-semibold uppercase"
				>
					Showing {totalPosts} of {totalPosts} posts
				</p>
			</section>

			<!-- Grid: featured as the full-width anchor row, the rest beside it -->
			<section aria-label="All posts" class="px-gutter pt-12 pb-16">
				<div class="mx-auto max-w-[1200px]">
					<ul
						id="post-grid"
						class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
					>
						{
							featuredPost && (
								<BlogCard
									slug={featuredPost.id}
									title={featuredPost.data.title}
									description={featuredPost.data.description}
									pubDate={formatDate(featuredPost.data.pubDate)}
									sortDate={featuredPost.data.pubDate.toISOString()}
									readTime={featuredPost.data.readTime}
									heroImage={featuredPost.data.heroImage}
									tags={featuredPost.data.tags}
									featured
								/>
							)
						}
						{
							otherPosts.map((post) => (
								<BlogCard
									slug={post.id}
									title={post.data.title}
									description={post.data.description}
									pubDate={formatDate(post.data.pubDate)}
									sortDate={post.data.pubDate.toISOString()}
									readTime={post.data.readTime}
									heroImage={post.data.heroImage}
									tags={post.data.tags}
								/>
							)
						)}
					</ul>
					<p
						id="search-empty"
						hidden
						class="mt-10 border-4 border-ink bg-accent px-6 py-8 text-center text-2xl font-extrabold tracking-tighter text-white uppercase"
					>
						No posts match your search.
					</p>
				</div>
			</section>
		</main>

		<Footer />
		<BackToTop />

		<script>
			// Lives in sessionStorage so the grid state survives a round
			// trip through a post page during view-transition navigation.
			const QUERY_KEY = 'theblog:search-query';
			const SORT_KEY = 'theblog:search-sort';
			const RETURN_FLAG = 'theblog:return-home';
			const RETURN_SCROLL = 'theblog:return-scroll';

			// Registered once per document (which survives router swaps):
			// mark outgoing navigations so home can restore the spot you
			// left from — clicking into a post, or "All posts"/logo back.
			document.addEventListener(
				'click',
				(event) => {
					if (
						event.defaultPrevented ||
						event.button !== 0 ||
						event.metaKey ||
						event.ctrlKey ||
						event.shiftKey ||
						event.altKey
					) {
						return;
					}
					const anchor = (event.target as Element | null)?.closest?.('a');
					if (!anchor) return;
					const target = new URL(anchor.href, location.href);
					if (location.pathname === '/' && target.pathname.startsWith('/posts/')) {
						sessionStorage.setItem(RETURN_FLAG, '1');
						sessionStorage.setItem(RETURN_SCROLL, String(Math.round(window.scrollY)));
					} else if (location.pathname !== '/' && target.pathname === '/') {
						sessionStorage.setItem(RETURN_FLAG, '1');
					}
				},
				true,
			);

			function initGrid() {
				const input = document.getElementById('blog-search') as HTMLInputElement | null;
				const sortSelect = document.getElementById('post-sort') as HTMLSelectElement | null;
				const grid = document.querySelector<HTMLElement>('#post-grid');
				const countEl = document.getElementById('search-count');
				const emptyEl = document.getElementById('search-empty');
				if (!input || !sortSelect || !grid || !countEl || !emptyEl) return;

				const allCards = Array.from(
					document.querySelectorAll<HTMLElement>('[data-post-card]'),
				);

				// Search counts every card (featured banner included)
				const applyFilter = () => {
					const query = input.value.trim().toLowerCase();
					let shown = 0;

					for (const card of allCards) {
						const match = query === '' || card.dataset.search!.includes(query);
						card.hidden = !match;
						if (match) shown++;
					}

					countEl.textContent = `Showing ${shown} of ${allCards.length} posts`;
					emptyEl.hidden = shown > 0;
					sessionStorage.setItem(QUERY_KEY, input.value);
				};

				// Sort by date (newest/oldest) or read time (shortest/longest).
				// The featured card stays pinned first so the grid keeps
				// its anchor; everything else sorts around it.
				const applySort = () => {
					const mode = sortSelect.value;
					const byDate = mode === 'newest' || mode === 'oldest';
					const ascending = mode === 'oldest' || mode === 'shortest';
					const featured = allCards.find(
						(card) => card.dataset.featured !== undefined,
					);
					const rest = allCards
						.filter((card) => card !== featured)
						.sort((a, b) => {
							const diff = byDate
								? Date.parse(a.dataset.pubdate!) - Date.parse(b.dataset.pubdate!)
								: Number(a.dataset.readtime) - Number(b.dataset.readtime);
							return ascending ? diff : -diff;
						});

					for (const card of [...(featured ? [featured] : []), ...rest]) {
						grid.append(card);
					}
					sessionStorage.setItem(SORT_KEY, mode);
				};

				input.addEventListener('input', applyFilter);
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						input.value = '';
						applyFilter();
					}
				});
				sortSelect.addEventListener('change', applySort);

				// Restore the search text and sort option when navigating
				// back from a post so the grid feels untouched.
				const savedQuery = sessionStorage.getItem(QUERY_KEY);
				const savedSort = sessionStorage.getItem(SORT_KEY);
				if (savedSort) sortSelect.value = savedSort;
				if (savedQuery) input.value = savedQuery;
				if (savedQuery || savedSort) {
					applySort();
					applyFilter();
				}

				// Returning from a post (card click or "All posts"): land
				// on the scroll position the grid was left at, after any
				// filtering/sorting above settles the layout first.
				if (sessionStorage.getItem(RETURN_FLAG) === '1') {
					sessionStorage.removeItem(RETURN_FLAG);
					const savedScroll = Number(sessionStorage.getItem(RETURN_SCROLL));
					if (savedScroll > 0) {
						window.scrollTo({ top: savedScroll, behavior: 'instant' });
					}
				}
			}

			// The router swaps <body> between pages, so re-init on every
			// navigation; astro:page-load also fires on the initial load.
			document.addEventListener('astro:page-load', initGrid);
		</script>
	</body>
</html>
