---
import { Icon } from 'astro-icon/components';
---

<!-- Floating back-to-top button: slides in from beyond the right
     edge after the user scrolls down, slides away at the top. -->
<a
	href="#top"
	id="back-to-top"
	aria-label="Back to top"
	class="fixed right-6 bottom-6 z-50 pointer-events-none grid size-14 place-items-center border-4 border-ink bg-accent text-white shadow-[6px_6px_0_0_#000] transition-transform duration-300 ease-out translate-x-[calc(100%+32px)]"
>
	<Icon name="lucide:arrow-up" size={22} />
</a>

<style>
	/* Shown state: slide back into the viewport */
	#back-to-top.is-shown {
		translate: none;
		pointer-events: auto;
	}

	/* Respect reduced motion: jump, don't slide */
	@media (prefers-reduced-motion: reduce) {
		#back-to-top {
			transition: none;
		}
	}
</style>

<script>
	const button = document.getElementById('back-to-top') as HTMLAnchorElement;
	if (button) {
		let ticking = false;
		const update = () => {
			const shown = window.scrollY > window.innerHeight * 0.75;
			button.classList.toggle('is-shown', shown);
			button.toggleAttribute('inert', !shown);
		};

		window.addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				update();
				ticking = false;
			});
		}, { passive: true });

		update();
	}
</script>
