---
import { Icon } from 'astro-icon/components';
import { SITE } from '../lib/posts';
---

<header class="border-b-4 border-ink bg-ground">
	<div
		class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-gutter"
	>
		<a
			href="/"
			class="flex items-center gap-3 text-lg leading-none font-extrabold tracking-tighter uppercase"
		>
			<!-- Logo mark: triangle · square · circle in the theme colors -->
			<span
				aria-hidden="true"
				class="flex items-center gap-1"
			>
				<span class="relative block size-4 bg-ink [clip-path:polygon(50%_0,100%_100%,0_100%)]"><span class="absolute inset-[2px] bg-accent [clip-path:polygon(50%_0,100%_100%,0_100%)]"></span></span>
				<span class="block size-4 border-2 border-ink bg-field"></span>
				<span class="block size-4 rounded-full border-2 border-ink bg-support"></span>
			</span>
      {SITE.name}
    </a>
      <!-- <span class="lowercase border-2 text-sm p-1"> -->
      <!--   Still under development, check later -->
      <!-- </span> -->
		<nav aria-label="Main">
			<ul
				class="flex items-center gap-4 text-[15px] font-semibold uppercase sm:gap-6"
			>
				<li>
					<a
						href="/#posts"
						class="flex items-center gap-1.5 hover:underline hover:decoration-accent hover:decoration-4 underline-offset-4"
					>
						<Icon name="lucide:newspaper" size={15} />
						Posts
					</a>
				</li>
				<li>
					<a
						href="#about"
						class="flex items-center gap-1.5 hover:underline hover:decoration-accent hover:decoration-4 underline-offset-4"
					>
						<Icon name="lucide:info" size={15} />
						About
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
